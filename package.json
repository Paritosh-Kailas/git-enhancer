{
  "name": "git-enhancer-cli",
  "version": "0.1.0",
  "description": "A colorful TypeScript CLI that enhances everyday Git workflows.",
  "private": true,
  "type": "module",
  "bin": {
    "gx": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsx src/cli.ts",
    "gx": "node dist/cli.js",
    "start": "node dist/cli.js",
    "link:local": "npm link",
    "unlink:local": "npm unlink -g git-enhancer-cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "node scripts/setup-husky.mjs"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^24.6.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
